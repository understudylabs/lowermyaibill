#!/usr/bin/env node

import { resolve } from "node:path";
import { runAudit, runReport } from "../src/audit.mjs";
import { scanRepository } from "../src/scan.mjs";

const fancy = Boolean(process.stdout.isTTY && !process.env.NO_COLOR && process.env.TERM !== "dumb");
const color = fancy ? {
  reset: "\u001b[0m", bold: "\u001b[1m", dim: "\u001b[2m",
  clay: "\u001b[38;2;217;119;87m", amber: "\u001b[38;2;226;190;118m",
  mint: "\u001b[38;2;158;219;211m", cyan: "\u001b[38;2;72;204;231m",
  green: "\u001b[38;5;42m",
} : { reset: "", bold: "", dim: "", clay: "", amber: "", mint: "", cyan: "", green: "" };

function banner() {
  if (!fancy) return;
  const rows = [
    [color.clay, "  _                                       _   _    _ _ _ "],
    [color.clay, " | |_____ __ _____ _ _   _ __ _  _   __ _(_) | |__(_) | |"],
    [color.amber, " | / _ \\ V  V / -_) '_| | '  \\ || | / _` | | | '_ \\ | | |"],
    [color.mint, " |_\\___/\\_/\\_/\\___|_|   |_|_|_\\_, | \\__,_|_| |_.__/_|_|_|"],
    [color.cyan, "                              |__/                       "],
  ];
  process.stdout.write("\n");
  for (const [tone, row] of rows) process.stdout.write(`  ${tone}${row}${color.reset}\n`);
  process.stdout.write(`  ${color.bold}${color.mint}${"LMAB".padStart(30)}${color.reset}\n`);
  process.stdout.write(`\n  ${color.dim}find the expensive routes. keep the evidence.${color.reset}\n`);
}

function section(title) {
  const ruleLength = Math.max(2, 54 - title.length);
  process.stdout.write(`\n  ${color.cyan}──${color.reset} ${color.bold}${title}${color.reset} ${color.cyan}${"─".repeat(ruleLength)}${color.reset}\n`);
}

function line(label, value) {
  process.stdout.write(`  ${color.dim}│${color.reset} ${color.dim}${label.padEnd(12)}${color.reset} ${value}\n`);
}

function usage() {
  return `Lower My AI Bill

Usage:
  lmab audit [repo]       scan and write .lmab/report.html
  lmab scan [repo]        write .lmab/scan.json
  lmab report [repo]      rebuild report from the code scan
  lmab doctor             check the local runtime
`;
}

function printResult(result, title) {
  if (fancy) {
    section(title);
    if (typeof result.files_scanned === "number") {
      const fileLabel = result.files_scanned === 1 ? "file" : "files";
      const opportunityLabel = result.opportunities === 1 ? "opportunity" : "opportunities";
      process.stdout.write(`  ${color.green}✓${color.reset} ${result.files_scanned.toLocaleString("en-US")} ${fileLabel} scanned · ${result.opportunities ?? 0} ${opportunityLabel}\n`);
    }
    for (const [label, value] of Object.entries(result)) {
      if (typeof value === "string") {
        const displayValue = value.startsWith(`${repo}/`) ? `./${value.slice(repo.length + 1)}` : value;
        line(label, displayValue);
      }
    }
    return;
  }
  for (const [label, value] of Object.entries(result)) {
    if (typeof value === "string") process.stdout.write(`${label}: ${value}\n`);
  }
}

const [command = "help", repoArg = "."] = process.argv.slice(2);
const repo = resolve(repoArg);

try {
  if (command === "audit") {
    banner();
    printResult(await runAudit(repo), "Audit complete");
  } else if (command === "scan") {
    banner();
    const result = await scanRepository(repo);
    printResult({ scan: result.scan, files_scanned: result.scanData.files_scanned, opportunities: result.scanData.opportunities.length }, "Scan complete");
  } else if (command === "report") {
    banner();
    printResult(await runReport(repo), "Report rebuilt");
  } else if (command === "doctor") {
    banner();
    if (fancy) {
      section("Doctor");
      process.stdout.write(`  ${color.green}✓${color.reset} Runtime ready · Node ${process.version}\n`);
    } else {
      process.stdout.write(`node: ${process.version}\n`);
      process.stdout.write("runtime: ok\n");
    }
  } else if (command === "help" || command === "--help" || command === "-h") {
    process.stdout.write(usage());
  } else {
    throw new Error(`Unknown command: ${command}\n\n${usage()}`);
  }
} catch (error) {
  process.stderr.write(`${error instanceof Error ? error.message : String(error)}\n`);
  process.exitCode = 1;
}
